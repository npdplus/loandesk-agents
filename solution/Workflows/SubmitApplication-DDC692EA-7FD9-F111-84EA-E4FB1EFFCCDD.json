                },
                "number_4": {
                  "title": "CreditScore",
                  "type": "number",
                  "x-ms-dynamically-added": true,
                  "description": "Mock credit score at submission (300 to 900). Empty when none.",
                  "x-ms-content-hint": "NUMBER"
                }
              },
              "required": [
                "text",
                "text_1",
                "text_2",
